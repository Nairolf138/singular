[Unit]
Description=Singular autonomous orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@SINGULAR_HOME@
EnvironmentFile=/etc/singular/singular.env
ExecStart=@SINGULAR_BINARY@ orchestrate run
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
